{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext",
    "moduleResolution": "bundler", "types": ["node"], "strict": true,
    "noEmit": true, "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo",
    "skipLibCheck": true, "verbatimModuleSyntax": true, "isolatedModules": true
  },
  "include": ["vite.config.ts"]
}
