# Production environment.
#
# Copy to `deploy/.env`, fill in, and keep it out of git — it is already in
# `.gitignore` and that is not a formality: this file grants read/write on
# every guest record and the ability to move money.
#
#   chmod 600 deploy/.env
#
# Two things are deliberately NOT here:
#
#   * the JWT signing keys — they are files, mounted as Docker secrets from
#     `deploy/secrets/`. An environment variable is visible in
#     `docker inspect`, in a crash dump, and in the process list of anything
#     that shells out.
#   * anything a browser needs. `VITE_*` values are baked into the frontend
#     images at build time and belong in the CI workflow, not here. A secret
#     passed as a build arg is a secret published on a CDN.
#
# Generating what needs generating:
#
#   openssl rand -base64 36            passwords
#   age-keygen -o age-key.txt          backup encryption (keep the private
#                                      half OFF this host)
#   ./scripts/gen-jwt-keys.sh          the signing pair

# ── images ────────────────────────────────────────────────────────────────
REGISTRY=ghcr.io/your-org/roaming-wandering
# Always an immutable tag — a commit SHA or a release. Never `latest`: a
# restart six weeks later would silently pull whatever `latest` points at
# then, which is not the version you tested.
TAG=

# ── database ──────────────────────────────────────────────────────────────
POSTGRES_USER=rw_app
POSTGRES_PASSWORD=
POSTGRES_DB=roaming_wandering

# Optional. Admin reports and vendor dashboards read this; everything
# transactional uses the primary. Unset means both point at the primary, which
# is correct for a single-node deployment.
DATABASE_REPLICA_DSN=

# ── redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── payments ──────────────────────────────────────────────────────────────
PAYMENT_ENABLED=true
# Public — the browser needs it to open checkout.
RAZORPAY_KEY_ID=
# Signs the checkout callback and authenticates API calls.
RAZORPAY_KEY_SECRET=
# Signs webhooks. **A different value.** A leaked webhook secret must not
# authenticate API calls, which is why Razorpay issues two.
RAZORPAY_WEBHOOK_SECRET=

# ── object storage ────────────────────────────────────────────────────────
# Blank for real AWS S3; set for MinIO, R2, Spaces.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rw-media-prod
S3_REGION=ap-south-1
# Where property photographs are served from. Public by design — they are on a
# public listing page — so they are served as public objects rather than
# presigned twenty at a time.
CDN_BASE_URL=https://cdn.roamingwandering.com

# ── AI ────────────────────────────────────────────────────────────────────
# Off by default. Every feature degrades rather than failing when it is off:
# recommendations lose their written explanation, the assistant and the
# itinerary planner answer 503, sentiment simply does not appear.
AI_ENABLED=false
AI_API_KEY=

# ── web ───────────────────────────────────────────────────────────────────
# Every origin allowed to call the API with credentials. The three own hosts
# and nothing else — a wildcard here with `credentials: include` is an
# open door.
CORS_ORIGINS=https://roamingwandering.com,https://www.roamingwandering.com,https://admin.roamingwandering.com,https://host.roamingwandering.com

# Which `Host` headers the API answers. **Required** — the application refuses
# to start in production with the `*` default, because it builds absolute URLs
# (password resets, invoices) from this header and a wildcard lets an attacker
# choose where those links point.
ALLOWED_HOSTS=roamingwandering.com,www.roamingwandering.com,admin.roamingwandering.com,host.roamingwandering.com

# ── email ─────────────────────────────────────────────────────────────────
# **Required.** `Settings` refuses to start a deployed environment without a
# working mailer, and that invariant exists because this system spent its whole
# early life unable to send anything: registration answered `202 unverified`,
# the verification mail was discarded three hops later, and no user could
# complete a signup or reset a password. Every dashboard stayed green.
#
# SMTP rather than a provider SDK, so SES, Postmark, Mailgun and a self-hosted
# relay are all the same four lines.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 587 upgrades a plaintext connection (START_TLS); 465 is TLS from the first
# byte (TLS). Exactly one of these is true — providers differ, and getting it
# wrong fails at connect time with an error that does not name the cause.
SMTP_START_TLS=true
SMTP_TLS=false

# The From address must be on a domain with SPF, DKIM and DMARC published, or
# a good share of what you send goes to spam — including the verification mails
# nobody can complete a signup without.
EMAIL_FROM_ADDRESS=no-reply@roamingwandering.com
EMAIL_FROM_NAME=Roaming & Wandering
EMAIL_REPLY_TO=support@roamingwandering.com

# Where the links inside a message point: the **customer site**, not the API.
# A verification link is opened by a person in a browser. Must be https —
# `Settings` refuses plaintext here, because the token in that URL is a bearer
# credential.
EMAIL_WEB_BASE_URL=https://roamingwandering.com

# ── backups ───────────────────────────────────────────────────────────────
# A DIFFERENT bucket from the media one, ideally a different account. A
# compromise that can write to media must not be able to delete backups —
# that is the shape of every ransomware incident.
BACKUP_S3_BUCKET=rw-backups-prod
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=ap-south-1
# age public key. The PRIVATE half must live somewhere else entirely — a
# password manager, a sealed envelope. Encrypting with a key stored beside the
# ciphertext is not encryption.
BACKUP_AGE_RECIPIENT=age1...
BACKUP_RETENTION_DAYS=30
# Optional dead-man's switch (healthchecks.io or similar). Alerts on the
# backup *not* running, which no metric emitted by a dead container can.
BACKUP_PING_URL=

# Salt for the client fingerprint that replaces raw IP addresses in access logs
# and rate-limit buckets. Any long random string; `openssl rand -hex 32`.
#
# Worth setting even though it is optional: a bare SHA-256 of an IPv4 address is
# reversible by brute force, since the whole space is 2^32. Rotating it
# re-buckets live rate limits once, which is harmless.
IP_HASH_SALT=

# ── observability ─────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=
SENTRY_DSN=
OTEL_ENDPOINT=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# ── TLS ───────────────────────────────────────────────────────────────────
# Expiry warnings go here. A real, monitored address — this is the only
# warning before the site stops loading for everyone.
CERTBOT_EMAIL=
