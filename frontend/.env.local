# Copy to .env.local. Everything here is PUBLIC — Vite inlines VITE_* into the
# bundle, so a secret placed here is published to every visitor.

# Relative by default, which keeps the app same-origin with the API. That is
# required, not cosmetic: the refresh token is an HttpOnly cookie scoped to
# /api/v1/auth, and a cross-origin base URL drops it, so login would work and
# session restore would not.
VITE_API_BASE_URL=/api/v1

# Where `npm run dev` proxies /api. Only used in development.
VITE_PROXY_TARGET=http://localhost:8000

# Razorpay's PUBLIC merchant key. Identifies the account; authorises nothing.
# The checkout session from the API carries this too — this is the fallback for
# rendering a checkout button before the session loads.
VITE_RAZORPAY_KEY_ID=
