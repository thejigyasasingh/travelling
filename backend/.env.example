# ══════════════════════════════════════════════════════════════════════════
# Roaming & Wandering — backend environment
#
# Copy to `.env` for local development:  cp .env.example .env
#
# Nested settings use a DOUBLE underscore delimiter:
#   DATABASE__POOL_SIZE  ->  settings.database.pool_size
#
# In staging/production NOTHING here is used — every value is injected from
# AWS Secrets Manager at runtime. `.env` is git-ignored and must never hold
# a real credential, even a staging one.
# ══════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=local                         # local | test | staging | production
APP_NAME="Roaming & Wandering API"
APP_VERSION=0.1.0
DEBUG=true                            # forced to false when APP_ENV=production
LOG_LEVEL=DEBUG                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                    # console (dev) | json (everything else)

# ── HTTP ──────────────────────────────────────────────────────────────────
HTTP__HOST=0.0.0.0
HTTP__PORT=8000
HTTP__ROOT_PATH=
HTTP__ALLOWED_HOSTS=["localhost","127.0.0.1","api.roamingwandering.local"]
HTTP__CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
HTTP__MAX_REQUEST_BYTES=10485760      # 10 MB; JSON bodies capped separately

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Writes go to the primary, ALWAYS. Reads may use the replica.
# Locally both point at the same container.
DATABASE__DSN=postgresql+asyncpg://rw_app:rw_local_pw@localhost:5432/roaming_wandering
DATABASE__REPLICA_DSN=postgresql+asyncpg://rw_app:rw_local_pw@localhost:5432/roaming_wandering
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=5
DATABASE__POOL_TIMEOUT_SECONDS=10
DATABASE__POOL_RECYCLE_SECONDS=1800
DATABASE__STATEMENT_TIMEOUT_MS=15000
DATABASE__LOCK_TIMEOUT_MS=2000        # see docs/design/migrations.md — never unset
DATABASE__ECHO_SQL=false

# ── Redis ─────────────────────────────────────────────────────────────────
# Logical DBs, one purpose each. Splitting to separate clusters later is a
# URL change, nothing more.
REDIS__URL=redis://localhost:6379
REDIS__CACHE_DB=0
REDIS__LOCK_DB=1
REDIS__RATELIMIT_DB=2
REDIS__BROKER_DB=3
REDIS__PUBSUB_DB=4
REDIS__MAX_CONNECTIONS=50
REDIS__SOCKET_TIMEOUT_SECONDS=2

# ── Celery ────────────────────────────────────────────────────────────────
CELERY__TASK_ALWAYS_EAGER=false       # true in tests: run tasks inline
CELERY__WORKER_CONCURRENCY=4
CELERY__TASK_SOFT_TIME_LIMIT_SECONDS=300
CELERY__TASK_TIME_LIMIT_SECONDS=360

# ── Security ──────────────────────────────────────────────────────────────
# RS256 keypair. Generate locally:
#   make keys
SECURITY__JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
SECURITY__JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
SECURITY__JWT_KEY_ID=local-dev-1
SECURITY__ACCESS_TOKEN_TTL_SECONDS=900          # 15 min — bounds stolen-token exposure
SECURITY__REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days
SECURITY__REFRESH_ROTATION_GRACE_SECONDS=10     # tolerate a lost refresh response
SECURITY__ARGON2_TIME_COST=3
SECURITY__ARGON2_MEMORY_KIB=65536               # 64 MB — makes GPU cracking uneconomic
SECURITY__ARGON2_PARALLELISM=4

# ── Authentication ────────────────────────────────────────────────────────
# Google sign-in. One client id per platform — web, Android and iOS each have
# their own, and ALL of them must be listed: the audience check is what stops a
# token issued to some other app from being accepted here.
AUTH__GOOGLE_ENABLED=false
AUTH__GOOGLE_CLIENT_IDS=[]

AUTH__OTP_ENABLED=true
# Returns the OTP in the API response so you can complete the flow with no SMS
# gateway. A boot failure in staging/production — see config.py.
AUTH__OTP_EXPOSE_DEBUG_CODE=true

# Refresh token as an HttpOnly cookie in addition to the response body.
# Browsers use the cookie (JavaScript, and therefore XSS, cannot read it);
# mobile clients ignore it and use the body.
AUTH__REFRESH_COOKIE_ENABLED=true
AUTH__REFRESH_COOKIE_NAME=rw_refresh
AUTH__REFRESH_COOKIE_SECURE=false     # localhost is HTTP; forced true when deployed
AUTH__REFRESH_COOKIE_SAMESITE=lax

# ── Payments (Razorpay) ───────────────────────────────────────────────────
# Three separate secrets. key_id is public — the browser needs it to open
# checkout. key_secret signs the checkout callback AND authenticates API calls.
# webhook_secret signs webhooks, and is deliberately a different value so a
# leaked webhook secret cannot be used to call the API.
PAYMENT__ENABLED=false
PAYMENT__RAZORPAY_KEY_ID=
PAYMENT__RAZORPAY_KEY_SECRET=
PAYMENT__RAZORPAY_WEBHOOK_SECRET=
# Capture on authorisation. Leave on: an uncaptured authorisation reverses
# after a few days and leaves a confirmed booking nobody was paid for.
PAYMENT__AUTO_CAPTURE=true
PAYMENT__DEFAULT_REFUND_SPEED=normal
PAYMENT__MAX_ATTEMPTS_PER_BOOKING=5

# ── Rate limiting ─────────────────────────────────────────────────────────
RATELIMIT__ENABLED=true
RATELIMIT__ANON_PER_MINUTE=100
RATELIMIT__USER_PER_MINUTE=300
RATELIMIT__FAIL_OPEN=true             # Redis down => allow. Auth endpoints fail CLOSED.

# ── Observability ─────────────────────────────────────────────────────────
OBSERVABILITY__SENTRY_DSN=
OBSERVABILITY__OTEL_ENDPOINT=
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__SLOW_REQUEST_MS=1000

# ── Object storage (MinIO locally, S3 in cloud) ───────────────────────────
STORAGE__ENDPOINT_URL=http://localhost:9000
STORAGE__ACCESS_KEY=minioadmin
STORAGE__SECRET_KEY=minioadmin
STORAGE__BUCKET=rw-media-local
STORAGE__REGION=ap-south-1
STORAGE__PRESIGN_TTL_SECONDS=900

# ── AI ───────────────────────────────────────────────────────────────────
# Off by default. Every feature degrades rather than failing when it is off:
# recommendations lose their written explanation, the assistant and the
# itinerary planner answer 503 with a plain sentence, sentiment simply does
# not appear. A model outage is never a booking outage.
AI__ENABLED=false
AI__API_KEY=
AI__MODEL=claude-sonnet-5
AI__FAST_MODEL=claude-haiku-4-5-20251001
# Per user. Not advisory — this is the one dependency that bills per call and
# can be driven by anyone with a keyboard.
AI__ITINERARIES_PER_USER_PER_DAY=10
AI__CHAT_MESSAGES_PER_USER_PER_HOUR=40

# ── Email ────────────────────────────────────────────────────────────────
# Points at Mailpit, which `make up` starts. Every message the app sends lands
# in its web UI at http://localhost:8025 — nothing leaves your machine.
#
# `ENABLED=true` locally on purpose. With it false, registration still returns
# 202 and the verification mail is recorded as `suppressed` rather than sent,
# which is a confusing first hour for anyone new to the project.
EMAIL__ENABLED=true
EMAIL__HOST=localhost
EMAIL__PORT=1025
EMAIL__START_TLS=false
EMAIL__TLS=false
EMAIL__FROM_ADDRESS=no-reply@roamingwandering.local
EMAIL__FROM_NAME=Roaming & Wandering (dev)
# Where the links in a message point: the customer site, not the API. A
# verification link is opened by a person in a browser.
EMAIL__WEB_BASE_URL=http://localhost:5173
