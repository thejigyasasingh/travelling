# ── secrets ───────────────────────────────────────────────────────────────
# Nothing that could ever be a credential. The JWT keypair is generated by
# `make keys` on every machine and injected from Secrets Manager in the cloud.
.env
.env.*
!.env.example
secrets/
*.pem
*.key
tests/fixtures/keys/

# ── python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ── tooling caches ────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── local runtime ─────────────────────────────────────────────────────────
celerybeat-schedule*
*.log
.DS_Store
.idea/
.vscode/
!.vscode/settings.json
